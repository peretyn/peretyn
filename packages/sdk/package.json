{
  "name": "@peretyn/sdk",
  "version": "0.1.0",
  "description": "Peretyn TypeScript SDK — typed client for the Peretyn runtime.",
  "keywords": [
    "authorization",
    "fga",
    "openfga",
    "rebac",
    "permissions",
    "peretyn"
  ],
  "homepage": "https://github.com/peretyn/peretyn/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/peretyn/peretyn/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/test-helpers.ts",
    "!src/generated",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@peretyn/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peretyn/peretyn.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
