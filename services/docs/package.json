{
  "name": "@peretyn/docs",
  "version": "0.2.1",
  "private": true,
  "description": "Peretyn developer documentation — Fumadocs on Next.js.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port ${PERETYN_DOCS_PORT:-3002}",
    "build": "next build",
    "start": "next start --port ${PERETYN_DOCS_PORT:-3002}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@peretyn/ui": "workspace:*",
    "fumadocs-core": "16.18.1",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-openapi": "12.6.0",
    "fumadocs-ui": "16.18.1",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@peretyn/eslint-config": "workspace:*",
    "@peretyn/sdk": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "containerConfig": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}
