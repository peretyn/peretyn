{
  "name": "@peretyn/control",
  "version": "0.2.0",
  "private": true,
  "description": "Peretyn control plane — Hono service, owns peretyn_control schema.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:push": "drizzle-kit push",
    "enroll": "node dist/scripts/enroll.js"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@peretyn/org-roles": "workspace:*",
    "@praha/byethrow": "0.11.2",
    "@praha/error-factory": "1.4.1",
    "better-auth": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "http-status-codes": "catalog:",
    "pg": "catalog:",
    "resend": "6.32.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@peretyn/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "containerConfig": {
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ]
  }
}
